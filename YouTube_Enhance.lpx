#!name=YouTube Enhance for Loon
#!desc=Loon/iOS 当前兼容版：前置/中插广告、Sponsored 信息流广告、后台播放、字幕翻译与界面精简。播放器请求与 ad_break 采用当前 Loon 专用实现，initplayback POST 直接返回空视频让客户端回退到无广告 Player 链路。
#!openUrl=https://apps.apple.com/app/id544007664
#!author=Maasea, teaoea, aijc123
#!tag=YouTube,去广告,后台播放
#!system=iOS, iPadOS, macOS
#!system_version=15
#!loon_version=3.5.1(998)
#!homepage=https://github.com/aijc123/Loon-YouTube-Enhance
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!date=2026-10-05

[Argument]
blockUpload=switch, false, true, tag=隐藏上传按钮, desc=隐藏 YouTube 底栏上传按钮
blockShorts=switch, true, false, tag=隐藏 Shorts 按钮, desc=隐藏 YouTube 底栏 Shorts 按钮
blockImmersive=switch, false, true, tag=隐藏选段按钮, desc=隐藏 YouTube Music 底栏选段按钮
captionLang=select, "off", "zh-Hans", "zh-Hant", "ja", "ko", "en", "fr", "de", "ru", "fil", "vi", tag=字幕翻译语言, desc=off 为关闭；其余为目标字幕语言
playback_region=select, "original", "US", "HK", "TW", "JP", "KR", "SG", "GB", "DE", "RU", "CN", tag=播放请求地区, desc=默认 original，不修改出口 IP，仅在需要排障时改客户端 gl
log_enabled=switch, false, true, tag=开发日志, desc=默认关闭；仅排障时开启
log_level=select, "error", "info", "debug", "warn", tag=日志级别, desc=仅开发日志开启时有意义
capture_budget=select, "16", "32", "64", tag=日志容量MB, desc=仅开发日志开启时有意义
debug=switch, false, true, tag=调试模式, desc=仅排障时开启

[Rule]
# API 与媒体协商都强制从 QUIC/UDP 443 回退到可被 Loon MitM/脚本检查的 TCP。
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Rewrite]
# 当前 iOS YouTube initplayback（Onesie/UMP）绕过普通 player 的关键入口。
# 对 YouTube App 的 POST 直接返回 Loon 内置空视频，迫使客户端回退到已被脚本净化的 player 链路。
request if ${url} ~= /^https:\/\/[a-z0-9-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$/i && ${request.method} == "POST" && ${request.header['User-Agent']} ~= /(?:^|\s)com\.google\.ios\.youtube\//i then reject_video(200)

# 清除媒体源 Alt-Svc，降低 QUIC 被拒绝后再次协商 HTTP/3 的机会。
^https://(?:[\w-]+\.)*googlevideo\.com(?::443)?/ response-header-replace Alt-Svc clear

# 广告 tracking / telemetry 兜底；真正的主过滤在 player/ad_break、player 请求和 feed response。
request if ${url} ~= /^https:\/\/www\.youtube\.com\/(pagead|pcs)\//i then reject(200)
request if ${url} ~= /^https:\/\/www\.youtube\.com\/ptracking/i then reject(200)
request if ${url} ~= /^https:\/\/(?:www|s)\.youtube\.com\/api\/stats\/ads/i then reject(200)
request if ${url} ~= /^https:\/\/(?:www|s)\.youtube\.com\/api\/stats\/qoe\?.*adcontext/i then reject(200)

[Script]
# 1) 播放请求净化：删除广告 signals/adParams/forceAdParameters，并写入 isInlinePlaybackNoAd。
# 2) 精确阻断 /player/ad_break，返回合法空 Protobuf，阻止新的片头/中插广告配置。
http-request ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/aijc123/Loon-YouTube-Enhance/main/vendor/teaoea/request.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget},{playback_region}],tag=YouTube播放请求去广告

# 信息流/播放页推荐/搜索 Sponsored 卡片：使用当前 Loon iOS 样本适配实现。
http-response ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$ script-path=https://raw.githubusercontent.com/aijc123/Loon-YouTube-Enhance/main/vendor/teaoea/response.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget}],tag=YouTube信息流去广告

# 播放响应：保留此前在你设备上能工作的 Maasea/Kelee Loon 路径，
# 负责 player/get_watch/reel 的广告字段、后台播放、字幕翻译和 UI 开关。
response if ${url} ~= /^https:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/(player|get_watch|reel\/reel_watch_sequence|guide|account\/get_setting)(\?.*)?$/i then script("https://raw.githubusercontent.com/aijc123/Loon-YouTube-Enhance/main/scripts/stable/youtube.response.js", {${blockUpload}, ${blockShorts}, ${blockImmersive}, ${captionLang}, ${debug}}) with tag="YouTube播放增强", requires_body=true, binary_body_mode=true

[MitM]
hostname = youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, s.youtube.com, *.googlevideo.com
