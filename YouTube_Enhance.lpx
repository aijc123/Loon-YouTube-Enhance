#!name=YouTube Enhance for Loon
#!desc=基于 Maasea + 当前 YouTube Onesie/UMP 兼容链路：去广告、后台播放、PiP、字幕翻译与界面精简；针对 Sponsored 卡片和加密 initplayback 播放链路增强过滤。
#!openUrl=https://apps.apple.com/app/id544007664
#!author=Maasea[https://github.com/Maasea], gholts[https://github.com/gholts/surge], aijc123
#!tag=去广告
#!system=iOS, iPadOS, macOS
#!system_version=15
#!loon_version=3.5.1(998)
#!homepage=https://github.com/aijc123/Loon-YouTube-Enhance
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!date=2026-10-05

[Argument]
blockUpload=switch, false, true, tag=隐藏上传按钮, desc=用于隐藏YouTube底栏的上传按钮
blockShorts=switch, true, false, tag=隐藏Shorts按钮, desc=用于隐藏YouTube底栏的Shorts按钮
blockImmersive=switch, false, true, tag=隐藏选段按钮, desc=用于隐藏YouTube Music底栏的选段按钮
captionLang=select, "off", "zh-Hans", "zh-Hant", "ja", "ko", "en", "fr", "de", "ru", "fil", "vi", tag=字幕翻译语言, desc=需要把YouTube字幕翻译为何种语言
debug=switch, false, true, tag=启用调试模式, desc=此插件的调试模式

[Rule]
AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/www\.youtube\.com\/(pagead|pcs)\// then reject(200)
request if ${url} ~= /^https:\/\/www\.youtube\.com\/ptracking/ then reject(200)
request if ${url} ~= /^https:\/\/s\.youtube\.com\/api\/stats\/ads/ then reject(200)
request if ${url} ~= /^https:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext/ then reject(200)

[Script]
# Current feed/watch-page ad filtering. This path recognizes newer sponsoredVideo / sponsoredDisplay / promotedContents structures.
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(navigation\/resolve_url|browse|next|search|reel\/reel_watch_sequence)(\?.*)?$/i then script("https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/response.js") with tag="YouTube广告过滤", requires_body=true, binary_body_mode=true

# Keep Maasea's Loon-aware player/settings handler for background capability, UI options and caption translation.
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|guide|account\/get_setting|get_watch)(\?.*)?$/i then script("https://raw.githubusercontent.com/aijc123/Loon-YouTube-Enhance/main/scripts/youtube.response.js", {${blockUpload}, ${blockShorts}, ${blockImmersive}, ${captionLang}, ${debug}}) with tag="YouTube播放增强", requires_body=true, binary_body_mode=true

# Current encrypted Onesie/UMP key flow.
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(config|log_event)(\?.*)?$/i then script("https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/key.js") with tag="YouTube密钥配置", requires_body=true, binary_body_mode=true

# Process the actual encrypted initplayback response, not only the request.
response if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(\?.*)?$/i then script("https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/ump.js") with tag="YouTube UMP响应", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(\?.*)?$/i then script("https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js") with tag="YouTube UMP请求", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(\?.*)?$/i then script("https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js") with tag="YouTube日志事件"

request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(\?.*)?$/i then script("https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js") with tag="YouTube广告段"

[MitM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com
